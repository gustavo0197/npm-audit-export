<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NPM Audit Export</title>

    <style>
      {{{baseCss}}}
    </style>
    <style>
      {{{themeCss}}}
    </style>
  </head>
  <body class="theme--{{theme}}">
    <div class="header">
      <h2>NPM Audit Export</h2>
      <p class="export-date">{{date}}</p>
      <p>Generated with
        <a href="https://github.com/gustavo0197/npm-audit-export" target="_blank">npm-audit-export</a></p>
    </div>

    <div class="vulnerabilities-count">
      <div class="vulnerability-count">
        <p>Critical</p>
        <p class="severity-box--critical">{{counts.critical}}</p>
      </div>

      <div class="vulnerability-count">
        <p>High</p>
        <p class="severity-box--high">{{counts.high}}</p>
      </div>

      <div class="vulnerability-count">
        <p>Moderate</p>
        <p class="severity-box--moderate">{{counts.moderate}}</p>
      </div>

      <div class="vulnerability-count">
        <p>Low</p>
        <p class="severity-box--low">{{counts.low}}</p>
      </div>

      <div class="vulnerability-count">
        <p>Total</p>
        <p class="severity-box--low">{{counts.total}}</p>
      </div>
    </div>

    <div>
      {{#each dependencies}}
        <div class="dependency__box severity--{{this.severity}}">
          <div class="dependency__header">
            <div>
              <div class="severity-icon severity-box--{{this.severity}}">{{this.severityInitial}}</div>

              <div class="dependency__title">
                <h2 class="title">{{this.name}}</h2>

                {{#if this.isDirect}}
                  <p class="lozenge lozenge--danger">
                    DIRECT VULNERABILITY
                  </p>
                {{/if}}
              </div>
              <p class="dependency__header__total-issues">{{this.totalIssues}}</p>
            </div>
          </div>

          {{#if this.vulnerabilities}}
            <div class="dependency__body">
              <div class="dependency__vulnerabilities">
                {{#each this.vulnerabilities}}
                  <div class="dependency__vulnerability">
                    <div class="vulnerability">
                      <div class="vulnerability__description">
                        <div class="severity-icon severity-box--{{this.severity}}">{{this.severityInitial}}</div>
                        <p>{{this.title}}</p>

                        {{#if this.package}}
                          <p>↳</p>
                          <span>{{this.package}}</span>
                        {{/if}}
                      </div>

                      {{#if this.links}}
                        <div class="vulnerability__links">
                          {{#each this.links}}
                            <a target="_blank" href="{{this.url}}">{{this.label}}</a>
                          {{/each}}
                        </div>
                      {{/if}}
                    </div>
                  </div>
                {{/each}}
              </div>
            </div>
          {{/if}}
        </div>
      {{/each}}
    </div>
  </body>
</html>